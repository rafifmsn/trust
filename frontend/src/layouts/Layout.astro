---
import '../styles/globals.css';
import '../styles/starwind.css';
import Head from '../components/Head.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Trust - Rafif Muchsin',
  description = 'Trust (rafifmsn/trust) is a zero-trust domain triage dashboard to instantly analyze and verify domains for typo-squatting, homoglyph impersonations, and phishing indicators in real-time.',
  ogImage = '/og.png'
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark bg-background">
  <head>
    <Head title={title} description={description} ogImage={ogImage} />
  </head>
  <body class="min-h-screen flex justify-center">
    <div class="w-full max-w-7xl">
      <slot />
    </div>
  </body>
</html>
