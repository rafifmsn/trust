---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/starwind/button/Button.astro';
---

<Layout title="404 - Page Not Found">
  <main class="max-w-4xl mx-auto mt-12 px-6 py-12 flex flex-col items-center text-center gap-6">
    <div class="space-y-4">
      <h1 class="text-3xl lg:text-4xl font-bold tracking-tight text-foreground font-sans">
        404 - Not Found
      </h1>
      <p class="text-muted-foreground font-sans max-w-md mx-auto text-base">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
      </p>
    </div>
    <Button as="a" href="/" variant="default" class="font-sans px-6 py-2.5">
      Go back home
    </Button>
  </main>
</Layout>
